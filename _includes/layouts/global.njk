<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="{{ description or 'Zi Wei — Personal site' }}">
  <title>{{ title or "Zi Wei" }}{% if subtitle %} — {{ subtitle }}{% endif %}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  {% if pageCss %}
  <link rel="stylesheet" href="{{ pageCss | url }}">
  {% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a href="#main-content" class="sr-only">Skip to main content</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="{{ '/' | url }}" class="site-logo"><span class="logo-bracket">&lt;</span> Zi Wei <span class="logo-bracket">&gt;</span></a>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-text">&copy; {% year %} Zi Wei</p>
    </div>
  </footer>

  {% if pageJs %}
  <script{% if pageJsType %} type="{{ pageJsType }}"{% endif %} src="{{ pageJs | url }}"></script>
  {% endif %}
</body>
</html>
