<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="{{ description or 'Zi Wei — Personal site' }}">
  <title>{{ title or "Zi Wei" }}{% if subtitle %} — {{ subtitle }}{% endif %}</title>
  {% include "theme-init.njk" %}
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v=__BUILD_VERSION__">
  {% if pageCss %}
  <link rel="stylesheet" href="{{ pageCss | url }}?v=__BUILD_VERSION__">
  {% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a href="#main-content" class="sr-only">Skip to main content</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="{{ '/' | url }}" class="site-logo"><span class="logo-bracket">&lt;</span> Zi Wei <span class="logo-bracket">&gt;</span></a>

      {% if not hideNav %}
      <nav class="site-nav" aria-label="Site navigation">
        <ul class="nav-list">
          {% for link in nav.links %}
            <li class="nav-item{% if link.children | length %} has-dropdown{% endif %}">
              {% if link.url %}
                <a href="{{ link.url | url }}" class="nav-link{% if link.children | length %} nav-trigger{% endif %}">{{ link.label }}</a>
              {% else %}
                <span class="nav-link nav-trigger">{{ link.label }}</span>
              {% endif %}

              {% if link.children | length %}
                <ul class="nav-dropdown">
                  {% for child in link.children %}
                    <li class="nav-dropdown-item">
                      <a href="{{ child.url | url }}" class="nav-dropdown-link">{{ child.label }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-text">&copy; {% year %} Zi Wei</p>
    </div>
  </footer>

  {% if pageJs %}
  <script{% if pageJsType %} type="{{ pageJsType }}"{% endif %} src="{{ pageJs | url }}?v=__BUILD_VERSION__"></script>
  {% endif %}
  <script src="{{ '/js/main.js' | url }}?v=__BUILD_VERSION__"></script>
</body>
</html>
